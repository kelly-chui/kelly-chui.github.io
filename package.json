{
  "name": "kelly-chui-blog",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "hugo server -D --watch --poll 700ms --baseURL http://localhost:1313/",
    "new": "tsx scripts/new-post.ts",
    "check": "npm run check:eof && npm run check:images",
    "check:optimized-images": "tsx scripts/check-optimized-images.ts",
    "build": "npm run check && hugo --minify --gc",
    "prepare": "sh scripts/setup-hooks.sh",
    "vendor:mermaid": "mkdir -p static/js/vendor && cp node_modules/mermaid/dist/mermaid.min.js static/js/vendor/mermaid.min.js",
    "vendor:katex": "mkdir -p static/css/vendor/fonts static/js/vendor && cp node_modules/katex/dist/katex.min.css static/css/vendor/katex.min.css && cp node_modules/katex/dist/katex.min.js static/js/vendor/katex.min.js && cp node_modules/katex/dist/contrib/auto-render.min.js static/js/vendor/auto-render.min.js && cp node_modules/katex/dist/fonts/* static/css/vendor/fonts/",
    "check:images": "tsx scripts/check-images.ts",
    "check:eof": "tsx scripts/check-eof.ts",
    "check:code-indentation": "tsx scripts/check-code-indentation.ts",
    "format:code-indentation": "tsx scripts/format-code-indentation.ts --fix",
    "optimize:images": "tsx scripts/optimize-images.ts",
    "optimize:video": "tsx scripts/optimize-video.ts"
  },
  "dependencies": {
    "katex": "^0.16.47",
    "mermaid": "^11.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1"
  }
}
